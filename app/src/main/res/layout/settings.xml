<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/navi_background" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView style="@style/SetupHeading" android:text="Settings" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/panel" android:layout_marginTop="20dp">
            <Switch android:id="@+id/desk_reader" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="48dp" android:text="Desk reader mode" android:textSize="18sp"
                android:textColor="@color/navi_text" android:showText="false" android:switchPadding="16dp" />
            <TextView style="@style/SetupBody"
                android:text="Start fingerprint prompts automatically for paired computers. Keep Navi open and leave the rear sensor within reach. Your fingerprint is still required for every approval. The screen stays awake while Navi is open." />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/panel" android:layout_marginTop="16dp">
            <TextView style="@style/SetupHeading" android:textSize="20sp" android:text="Stay available" />
            <TextView android:id="@+id/network_status" style="@style/SetupStatus" android:text="Network connection is off" />
            <TextView android:id="@+id/background_summary" style="@style/SetupBody" android:text="Set up notifications and background battery use" />
            <Button android:id="@+id/network_toggle" style="@style/SetupButton" android:text="Enable network authentication" />
            <Button android:id="@+id/background_setup" style="@style/SetupButton" android:text="Background setup &amp; instructions" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/panel" android:layout_marginTop="16dp">
            <TextView style="@style/SetupHeading" android:textSize="20sp" android:text="KDE Connect" />
            <TextView android:id="@+id/kdeconnect_status" style="@style/SetupStatus" />
            <TextView style="@style/SetupBody"
                android:text="Navi uses your existing KDE Connect pairing to receive pairing offers and approval requests from your computer." />
            <Button android:id="@+id/kdeconnect_setup" style="@style/SetupButton" android:text="Set up KDE Connect" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/panel" android:layout_marginTop="16dp">
            <TextView style="@style/SetupHeading" android:textSize="20sp" android:text="Remote approvals" />
            <TextView android:id="@+id/remote_status" style="@style/SetupStatus" android:text="Off" />
            <TextView style="@style/SetupBody"
                android:text="When KDE Connect can't reach this phone, for example on mobile data, a computer with remote approvals sends end-to-end encrypted requests through an ntfy server instead. Navi keeps one background connection to it. Set it up on the computer: System Settings → Navi Authenticator → ⋮ next to this phone → Remote Approvals." />
            <LinearLayout android:id="@+id/remote_list" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <Space android:layout_width="match_parent" android:layout_height="24dp" android:layout_weight="1" />
        <Button android:id="@+id/reset" style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp"
            android:text="Reset key and all pairings" android:textSize="13sp" android:textAllCaps="false" android:textColor="@color/navi_muted" />
        <Button android:id="@+id/settings_done" style="@style/SetupButton" android:text="Return to Navi" />
    </LinearLayout>
</ScrollView>
