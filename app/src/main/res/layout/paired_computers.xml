<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/navi_background" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView style="@style/SetupHeading" android:text="Paired computers" />
        <TextView android:id="@+id/computers_empty" style="@style/SetupBody" android:text="No computers paired yet."
            android:visibility="gone" />
        <LinearLayout android:id="@+id/computers_list" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="4dp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/panel" android:layout_marginTop="28dp">
            <TextView style="@style/SetupHeading" android:textSize="20sp" android:text="Pair a computer" />
            <TextView style="@style/SetupBody"
                android:text="1 · Before the first pairing, set up KDE Connect so Navi receives your computer's messages." />
            <Button android:id="@+id/pair_kdeconnect" style="@style/SetupButton" android:text="Set up KDE Connect" />
            <TextView style="@style/SetupBody"
                android:text="2 · On your computer, open System Settings → Navi Authenticator, choose this phone and press Enroll (or run host.py enroll in a terminal). The computer shows an 8-character code.\n3 · A code box appears in Navi. Type the code shown on the computer.\n4 · Approve the pairing request that follows with your fingerprint." />
            <TextView style="@style/SetupBody"
                android:text="No code box? If KDE Connect saved the offer to Downloads, tap Open Pairing Offer… and choose the navi-auth-enroll-offer-….json file. Navi checks it and tells you what to finish." />
            <Button android:id="@+id/pair_open_offer" style="@style/SetupButton" android:text="Open Pairing Offer…" />
            <TextView android:id="@+id/pair_status" style="@style/SetupStatus" android:visibility="gone" />
        </LinearLayout>
        <Button android:id="@+id/computers_done" style="@style/SetupButton" android:layout_marginTop="20dp" android:text="Return to Navi" />
    </LinearLayout>
</ScrollView>
