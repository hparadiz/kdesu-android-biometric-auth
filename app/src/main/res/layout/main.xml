<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="12dp">
            <ImageView android:layout_width="56dp" android:layout_height="56dp"
                android:src="@drawable/ic_authenticator" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginStart="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Navi Authenticator" android:textSize="22sp" android:textColor="@color/navi_text"
                    android:fontFamily="sans-serif-medium" />
                <TextView android:id="@+id/paired_count" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Your computers, one touch." android:textSize="14sp" android:textColor="@color/navi_secondary"
                    android:layout_marginTop="4dp" android:background="?android:attr/selectableItemBackground" />
            </LinearLayout>
            <ImageButton android:id="@+id/menu_button" android:layout_width="48dp" android:layout_height="48dp"
                android:src="@drawable/ic_menu" android:contentDescription="Menu"
                android:background="?android:attr/selectableItemBackgroundBorderless" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="2dp"
            android:background="@drawable/brand_divider" android:layout_marginTop="24dp" android:layout_marginBottom="22dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Approve with your fingerprint." android:textSize="14sp" android:textColor="@color/navi_secondary" />
        <LinearLayout android:id="@+id/pairing_panel" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/panel" android:layout_marginTop="16dp" android:visibility="gone">
            <TextView style="@style/SetupHeading" android:textSize="20sp" android:text="Pair with a computer" />
            <TextView android:id="@+id/pairing_machine" style="@style/SetupBody" android:accessibilityLiveRegion="polite" />
            <EditText android:id="@+id/pairing_code" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:padding="14dp" android:background="@drawable/request_field"
                android:hint="ABCD-EFGH" android:textColorHint="@color/navi_muted" android:textColor="@color/navi_text"
                android:fontFamily="monospace" android:textSize="24sp" android:letterSpacing="0.15" android:gravity="center"
                android:maxLength="9" android:singleLine="true" android:importantForAutofill="no"
                android:inputType="textCapCharacters|textNoSuggestions|textVisiblePassword" android:imeOptions="actionDone" />
            <Button android:id="@+id/pairing_confirm" android:layout_width="match_parent" android:layout_height="52dp"
                android:layout_marginTop="16dp" android:text="Confirm code" android:textAllCaps="false"
                android:textSize="16sp" android:fontFamily="sans-serif-medium"
                android:background="@drawable/primary_button" android:backgroundTint="@color/action_background"
                android:textColor="@color/action_text" android:stateListAnimator="@null" />
            <Button android:id="@+id/pairing_open" style="@style/SetupButton" android:text="Pair a computer…" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:id="@+id/machine_badge" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone"
            android:background="@drawable/machine_panel" android:layout_marginTop="16dp">
            <ImageView android:id="@+id/machine_icon" android:layout_width="40dp" android:layout_height="40dp"
                android:src="@drawable/ic_computer" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginStart="14dp">
                <TextView android:id="@+id/machine_name" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="24sp" android:fontFamily="sans-serif-medium" android:textColor="@color/navi_text" />
                <TextView android:id="@+id/machine_identity" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:textSize="12sp" android:textColor="@color/navi_secondary" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/panel" android:layout_marginTop="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <View android:layout_width="6dp" android:layout_height="6dp" android:background="@drawable/status_dot" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="9dp" android:text="NAVI · ACCESS" android:textSize="11sp"
                    android:letterSpacing="0.10" android:textColor="@color/navi_cyan" />
            </LinearLayout>
            <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="18dp" android:text="Preparing your phone…" android:textSize="24sp"
                android:fontFamily="sans-serif-medium" android:textColor="@color/navi_text" android:accessibilityLiveRegion="polite" />
            <LinearLayout android:id="@+id/request_context" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:visibility="gone" android:layout_marginTop="18dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:id="@+id/requester_icon" android:layout_width="48dp" android:layout_height="48dp"
                        android:src="@drawable/ic_requester" android:scaleType="fitCenter" />
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                        android:orientation="vertical" android:layout_marginStart="14dp">
                        <TextView android:id="@+id/application_name" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:textSize="20sp" android:fontFamily="sans-serif-medium" android:textColor="@color/navi_text" />
                        <TextView android:id="@+id/account_line" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" android:textSize="13sp" android:textColor="@color/navi_secondary" />
                    </LinearLayout>
                </LinearLayout>
                <TextView android:id="@+id/preview_notice" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:text="Desktop verification preview · approving on the phone will not run this command."
                    android:textSize="13sp" android:textColor="#E8C988" android:visibility="gone" />
                <TextView android:id="@+id/command_label" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="18dp" android:text="Command to authorize" android:textSize="12sp" android:textColor="@color/navi_secondary" />
                <TextView android:id="@+id/command_text" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:padding="14dp" android:background="@drawable/request_field"
                    android:fontFamily="monospace" android:textSize="14sp" android:textColor="@color/navi_text" android:textIsSelectable="true" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:text="Request details" android:textSize="12sp" android:textColor="@color/navi_secondary" />
            <TextView android:id="@+id/detail" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:background="@drawable/request_field"
                android:padding="14dp" android:textSize="15sp" android:textColor="@color/navi_text" android:lineSpacingExtra="3dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="18dp" android:text="Only approve requests you recognize."
                android:textSize="13sp" android:textColor="@color/navi_secondary" />
            <Button android:id="@+id/authenticate" android:layout_width="match_parent" android:layout_height="52dp"
                android:layout_marginTop="24dp" android:text="Approve request" android:textAllCaps="false"
                android:textSize="16sp" android:fontFamily="sans-serif-medium"
                android:background="@drawable/primary_button" android:backgroundTint="@color/action_background"
                android:textColor="@color/action_text" android:stateListAnimator="@null" />
            <Button android:id="@+id/enroll" style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Open biometric settings" android:textAllCaps="false" android:textColor="@color/navi_cyan" android:visibility="gone" />
        </LinearLayout>
        <Button android:id="@+id/details_toggle" style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="16dp"
            android:text="Show connection details" android:textSize="14sp" android:textAllCaps="false" android:textColor="@color/navi_cyan" />
        <LinearLayout android:id="@+id/connection_details" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/panel" android:visibility="gone">
            <TextView android:id="@+id/challenge" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Waiting for a signed request from your computer." android:textSize="11sp"
                android:fontFamily="monospace" android:textColor="@color/navi_secondary" android:textIsSelectable="true" />
            <TextView android:id="@+id/key_info" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:text="Preparing the phone signing key." android:textSize="11sp"
                android:fontFamily="monospace" android:textColor="@color/navi_secondary" android:textIsSelectable="true" />
        </LinearLayout>
        <Button android:id="@+id/proof" style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:text="View signed proof" android:textSize="14sp" android:textAllCaps="false" android:textColor="@color/navi_cyan" android:visibility="gone" />
        <Space android:layout_width="match_parent" android:layout_height="16dp" android:layout_weight="1" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="24dp">
            <ImageView android:layout_width="18dp" android:layout_height="18dp"
                android:src="@drawable/ic_lock" android:importantForAccessibility="no" />
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:layout_marginStart="10dp" android:text="Private key secured on this phone"
                android:textSize="13sp" android:textColor="@color/navi_secondary" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="Each approval signs a fresh challenge. Your fingerprint stays with Android."
            android:textSize="13sp" android:textColor="@color/navi_muted" android:lineSpacingExtra="3dp" />
    </LinearLayout>
</ScrollView>
