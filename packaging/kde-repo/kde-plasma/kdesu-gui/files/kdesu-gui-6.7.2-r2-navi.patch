@@ -0,0 +1,62 @@
+/*
+ * SPDX-FileCopyrightText: 2026 KDE contributors
+ * SPDX-License-Identifier: Artistic-2.0
+ */
+
+#include "commanddetails.h"
+
+#include <KLocalizedString>
+#include <KShell>
+#include <QSet>
+
+CommandDetails describeCommand(const QString &command)
+{
+    KShell::Errors error;
+    const QStringList arguments = KShell::splitArgs(command, KShell::AbortOnMeta, &error);
+    if (error == KShell::BadQuoting) {
+        return {{}, i18n("The quotation marks could not be matched. Review the complete command above.")};
+    }
+
+    // KShell does not recognize shell builtins or keywords. Tilde expansion also
+    // depends on the target account. Do not present those expressions as argv.
+    static const QSet<QString> shellWords = {
+        QStringLiteral("!"),       QStringLiteral("."),        QStringLiteral(":"),      QStringLiteral("if"),       QStringLiteral("then"),
+        QStringLiteral("else"),    QStringLiteral("elif"),     QStringLiteral("fi"),     QStringLiteral("for"),      QStringLiteral("while"),
+        QStringLiteral("until"),   QStringLiteral("do"),       QStringLiteral("done"),   QStringLiteral("case"),     QStringLiteral("esac"),
+        QStringLiteral("select"),  QStringLiteral("function"), QStringLiteral("time"),   QStringLiteral("coproc"),   QStringLiteral("eval"),
+        QStringLiteral("exec"),    QStringLiteral("export"),   QStringLiteral("source"), QStringLiteral("cd"),       QStringLiteral("alias"),
+        QStringLiteral("unalias"), QStringLiteral("set"),      QStringLiteral("unset"),  QStringLiteral("readonly"), QStringLiteral("read"),
+        QStringLiteral("trap"),    QStringLiteral("umask"),    QStringLiteral("ulimit"), QStringLiteral("return"),   QStringLiteral("exit"),
+        QStringLiteral("break"),   QStringLiteral("continue"), QStringLiteral("shift"),  QStringLiteral("getopts"),  QStringLiteral("command"),
+        QStringLiteral("builtin"), QStringLiteral("enable"),   QStringLiteral("type"),   QStringLiteral("hash"),     QStringLiteral("wait"),
+        QStringLiteral("jobs"),    QStringLiteral("fg"),       QStringLiteral("bg"),
+    };
+    if (error == KShell::FoundMeta || command.contains(QLatin1Char('~')) || command.contains(QLatin1Char('\n')) || command.contains(QLatin1Char('\r'))
+        || command.contains(QLatin1Char('\t')) || (!arguments.isEmpty() && shellWords.contains(arguments.first()))) {
+        return {{},
+                i18n("This is a shell expression. Its effects can depend on expansions, redirects, or other commands. "
+                     "Review the complete text above; it has not been evaluated.")};
+    }
+    if (arguments.isEmpty() || arguments.first().isEmpty()) {
+        return {{}, i18n("No program was specified.")};
+    }
+    return {arguments,
+            i18n("The first word selects the program; the remaining words are passed as arguments. "
+                 "Quotes group words into a single argument. The program defines what each argument does.")};
+}
+
+QString describeArgument(const QString &argument, int index)
+{
+    if (index == 0) {
+        return i18n("Program or shell builtin to run");
+    }
+    if (argument.isEmpty()) {
+        return i18n("Argument %1: an empty string", index);
+    }
+    // Option syntax is a convention: even '--' is not universal, and an
+    // option-looking word might be the value of an earlier argument.
+    if (argument.startsWith(QLatin1Char('-')) && argument.size() > 1) {
+        return i18n("Argument %1: option-style text; interpreted by the program", index);
+    }
+    return i18n("Argument %1: passed to the program as one value", index);
+}
