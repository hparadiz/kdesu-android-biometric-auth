+void KDEsuDialog::accept()
+{
+    if (m_authenticating || m_fatalError || m_cancelled || m_phoneCommitted) {
+        return;
+    }
+    if (m_phoneAuth && m_phoneAuth->pending()) {
+        m_phoneFallback = PhoneFallback::Password;
+        setPhoneBusy(true);
+        setPhoneStatus(i18n("Canceling the phone request before checking your password…"));
+        m_phoneAuth->cancel();
+        return;
+    }
+    m_authenticating = true;
+    m_error->hide();
+    m_buttons->setEnabled(false);
+    m_password->setEnabled(false);
+    QTimer::singleShot(0, this, [this] {
+        if (m_cancelled) {
+            return;
+        }
+        const bool authenticated = checkPassword();
+        m_authenticating = false;
+        m_buttons->setEnabled(true);
+        m_password->setEnabled(!m_fatalError);
+        m_buttons->button(QDialogButtonBox::Ok)->setEnabled(!m_fatalError);
+        if (authenticated) {
+            QDialog::accept();
+        } else {
+            m_password->clear();
+            m_password->setFocus(Qt::OtherFocusReason);
+        }
+    });
+}
+
+void KDEsuDialog::reject()
+{
+    m_cancelled = true;
+    if (m_phoneAuth) {
+        m_phoneAuth->cancel();
+    }
+    m_password->clear();
+    QDialog::reject();
+}
+
+void KDEsuDialog::showErrorMessage(const QString &message, bool fatal)
+{
+    m_fatalError = fatal;
+    if (fatal) {
+        withdrawNotification(QStringLiteral("unavailable"));
+    }
+    m_error->setText(message);
+    m_error->setAccessibleName(message);
+    m_error->show();
+    m_password->lineEdit()->setAccessibleDescription(message);
+    QAccessibleEvent event(m_error, QAccessible::Alert);
+    QAccessible::updateAccessibility(&event);
+}
+
+bool KDEsuDialog::checkPassword()
+{
+    const int status = proc.checkInstall(password().toLocal8Bit().constData());
+    switch (status) {
+    case 0:
+        return true;
+    case -1:
+        showErrorMessage(i18n("Could not communicate with the authentication service. Please try again."));
+        break;
+    case KDESu::SuProcess::SuNotFound:
+        showErrorMessage(i18n("The program 'su' could not be found. Check that it is installed and available in PATH."), true);
+        break;
+    case KDESu::SuProcess::SuNotAllowed:
+        showErrorMessage(i18n("This account is not allowed to perform this action."), true);
+        break;
+    case KDESu::SuProcess::SuIncorrectPassword:
+        showErrorMessage(
+            i18n("Authentication was unsuccessful. Check the password and try again. "
+                 "Your account may also need permission to use su, such as membership in the wheel group."));
+        break;
+    default:
+        showErrorMessage(i18n("The authentication service returned an unexpected result."), true);
+        break;
+    }
+    return false;
+}
