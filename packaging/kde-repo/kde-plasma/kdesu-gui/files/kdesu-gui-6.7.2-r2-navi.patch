+    }
+
+    void dismissalIgnoresLateReady()
+    {
+        FakeAuthority authority;
+        QVERIFY(authority.listen());
+        TestAuthorityClient client(authority.path());
+        TestDialog dialog;
+        dialog.setPhoneAuthentication(&client, {});
+        dialog.show();
+        QTRY_VERIFY(authority.acceptConnection());
+        QTRY_VERIFY(authority.readStart());
+        dialog.reject();
+        QTRY_VERIFY(authority.hasEvent());
+        QCOMPARE(authority.takeEvent().value(QStringLiteral("event")).toString(), QStringLiteral("cancel"));
+        authority.send(authority.reply(QStringLiteral("ready")));
+        authority.send(authority.reply(QStringLiteral("canceled")));
+        QTRY_VERIFY(!client.pending());
+        QVERIFY(!client.committed());
+        QCOMPARE(dialog.result(), int(QDialog::Rejected));
+        QCOMPARE(dialog.attempts, 0);
+        QVERIFY(!authority.hasEvent());
+    }
+};
