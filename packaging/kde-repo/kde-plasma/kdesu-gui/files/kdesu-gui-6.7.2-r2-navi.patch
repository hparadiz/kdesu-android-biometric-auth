+/*
+ * SPDX-FileCopyrightText: 2026 KDE contributors
+ * SPDX-License-Identifier: Artistic-2.0
+ */
+
+#pragma once
+
+#include <QJsonObject>
+#include <QObject>
+
+class QProcess;
+class QTimer;
+
+class PhoneAuthClient : public QObject
+{
+    Q_OBJECT
+public:
+    explicit PhoneAuthClient(QObject *parent = nullptr);
+    ~PhoneAuthClient() override;
+
+    void start(const QJsonObject &context, const QJsonObject &environment);
+    void commit();
+    void cancel();
+    bool pending() const;
+    bool committed() const;
+
+Q_SIGNALS:
+    void waitingForPhone();
+    void ready();
+    void executed(qint64 pid);
+    void canceled();
+    void unavailable(const QString &message);
+    void uncertain(const QString &message);
+
+protected:
+    // Test subclasses use a private fake helper. Production has no runtime override.
+    virtual QString helperPath() const;
+    virtual bool trustedHelper(const QString &path) const;
+
+private:
+    enum class State {
+        Idle,
+        Starting,
+        Waiting,
+        Cancelling,
+        Committed,
+        Finished
+    };
+    void readMessages();
+    void fail(const QString &message);
+    void finish();
+    void withdraw();
+    QByteArray message(const QString &event) const;
+
+    QProcess *m_process = nullptr;
+    QTimer *m_startTimeout;
+    QTimer *m_lifetime;
+    QTimer *m_shutdownGrace;
+    State m_state = State::Idle;
+    QString m_requestId;
+    QByteArray m_startLine;
+    QByteArray m_input;
+    QString m_failure;
+    bool m_startSent = false;
+    bool m_ready = false;
+    bool m_committed = false;
+    bool m_cancelRequested = false;
+    bool m_withdrawing = false;
+    bool m_terminationAttempted = false;
+};
diff --git a/kdesu/phonenotification.cpp b/kdesu/phonenotification.cpp
new file mode 100644
index 00000000..46fadc23
--- /dev/null
+++ b/kdesu/phonenotification.cpp
@@ -0,0 +1,164 @@
+/*
+ * SPDX-FileCopyrightText: 2026 KDE contributors
+ * SPDX-License-Identifier: Artistic-2.0
+ */
+
+#include "phonenotification.h"
+
+#include <QBuffer>
+#include <QDir>
+#include <QFile>
+#include <QFileInfo>
+#include <QIcon>
+#include <QJsonDocument>
+#include <QLocalSocket>
+#include <QStandardPaths>
+#include <QTimer>
+#include <QUuid>
+
+#include <sys/stat.h>
+#include <unistd.h>
+#ifdef Q_OS_LINUX
+#include <sys/socket.h>
+#endif
+
+namespace
+{
+constexpr qsizetype maximumEventBytes = 64 * 1024;
+constexpr qsizetype maximumIconBytes = 16 * 1024;
+
+QByteArray eventLine(const QJsonObject &event)
+{
+    return QJsonDocument(event).toJson(QJsonDocument::Compact) + '\n';
+}
+
+bool privateSocket(const QString &path)
+{
+    struct stat directory;
+    struct stat socket;
+    return !path.isEmpty() && lstat(QFile::encodeName(QFileInfo(path).absolutePath()).constData(), &directory) == 0 && S_ISDIR(directory.st_mode)
+        && directory.st_uid == getuid() && (directory.st_mode & 0077) == 0 && lstat(QFile::encodeName(path).constData(), &socket) == 0
+        && S_ISSOCK(socket.st_mode) && socket.st_uid == getuid() && (socket.st_mode & 0077) == 0;
+}
+
+bool sameUserPeer(qintptr descriptor)
+{
+#ifdef Q_OS_LINUX
+    struct ucred peer;
+    socklen_t length = sizeof(peer);
+    return getsockopt(int(descriptor), SOL_SOCKET, SO_PEERCRED, &peer, &length) == 0 && length == sizeof(peer) && peer.uid == getuid();
+#else
+    Q_UNUSED(descriptor)
+    return false;
+#endif
+}
+}
+
+PhoneNotification::PhoneNotification(const QString &socketPath, QObject *parent)
+    : QObject(parent)
+    , m_socketPath(socketPath)
+    , m_requestId(QUuid::createUuid().toString(QUuid::WithoutBraces))
+    , m_socket(new QLocalSocket(this))
+    , m_connectTimeout(new QTimer(this))
+{
+    if (m_socketPath.isEmpty()) {
+        const QString runtime = QStandardPaths::writableLocation(QStandardPaths::RuntimeLocation);
+        if (!runtime.isEmpty()) {
+            m_socketPath = QDir(runtime).filePath(QStringLiteral("navi-auth/events.sock"));
+        }
+    }
+    m_connectTimeout->setSingleShot(true);
+    m_connectTimeout->setInterval(1500);
+    connect(m_connectTimeout, &QTimer::timeout, this, [this] {
+        finish(QStringLiteral("unavailable"));
+    });
+    connect(m_socket, &QLocalSocket::connected, this, [this] {
+        m_connectTimeout->stop();
+        if (m_finished || !sameUserPeer(m_socket->socketDescriptor())) {
+            finish(QStringLiteral("unavailable"));
+            return;
+        }
+        m_started = m_socket->write(m_startLine) == m_startLine.size();
+        m_startLine.clear();
+        if (m_started) {
+            m_socket->flush();
+        } else {
+            finish(QStringLiteral("unavailable"));
+        }
+    });
+    connect(m_socket, &QLocalSocket::disconnected, this, [this] {
+        m_finished = true;
+        m_connectTimeout->stop();
+    });
+    connect(m_socket, &QLocalSocket::errorOccurred, this, [this] {
+        finish(QStringLiteral("unavailable"));
+    });
+    // The channel has no approval response. Bound and discard any unsolicited input.
+    m_socket->setReadBufferSize(4096);
+    connect(m_socket, &QLocalSocket::readyRead, this, [this] {
+        m_socket->readAll();
+    });
+}
+
+PhoneNotification::~PhoneNotification()
+{
+    finish(QStringLiteral("closed"));
+    // Destruction also closes the connection: the host must withdraw on EOF.
+}
+
+void PhoneNotification::start(const QJsonObject &context)
+{
+    if (m_attempted || m_finished) {
+        return;
+    }
+    m_attempted = true;
+    m_startLine = eventLine({{QStringLiteral("protocol"), QStringLiteral("navi-auth-desktop/v1")},
+                             {QStringLiteral("event"), QStringLiteral("start")},
+                             {QStringLiteral("request_id"), m_requestId},
+                             {QStringLiteral("mode"), QStringLiteral("notification-only")},
+                             {QStringLiteral("context"), context}});
+    if (m_startLine.size() > maximumEventBytes || !privateSocket(m_socketPath)) {
+        finish(QStringLiteral("unavailable"));
+        return;
+    }
+    m_connectTimeout->start();
+    m_socket->connectToServer(m_socketPath, QIODevice::ReadWrite);
+}
+
+void PhoneNotification::finish(const QString &reason)
+{
+    if (m_finished) {
+        return;
+    }
+    m_finished = true;
+    m_connectTimeout->stop();
+    m_startLine.clear();
+    if (m_started && m_socket->state() == QLocalSocket::ConnectedState) {
+        m_socket->write(eventLine({{QStringLiteral("protocol"), QStringLiteral("navi-auth-desktop/v1")},
+                                   {QStringLiteral("event"), QStringLiteral("cancel")},
+                                   {QStringLiteral("request_id"), m_requestId},
+                                   {QStringLiteral("reason"), reason}}));
+        m_socket->flush();
+        m_socket->disconnectFromServer();
+    } else {
+        m_socket->abort();
+    }
+}
+
+QString PhoneNotification::iconPngBase64(const QIcon &icon)
+{
+    // Use physical pixel dimensions independent of the desktop's scale factor.
+    for (const int size : {128, 96, 64, 48, 32}) {
+        const QPixmap pixmap = icon.pixmap(QSize(size, size), 1.0);
+        if (pixmap.isNull()) {
+            return {};
+        }
+        QByteArray png;
+        QBuffer buffer(&png);
+        buffer.open(QIODevice::WriteOnly);
+        if (pixmap.toImage().save(&buffer, "PNG") && png.size() <= maximumIconBytes) {
+            return QString::fromLatin1(png.toBase64());
+        }
+    }
+    return {};
+}
