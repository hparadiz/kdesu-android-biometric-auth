+        QVERIFY(QFile::setPermissions(server.fullServerName(), QFileDevice::ReadOwner | QFileDevice::WriteOwner | QFileDevice::ReadOther));
+        PhoneNotification publicSocket(server.fullServerName());
+        publicSocket.start({});
+        QCoreApplication::processEvents();
+        QVERIFY(!server.hasPendingConnections());
+    }
+
+    void notificationIconIsBounded()
+    {
+        QImage noise(256, 256, QImage::Format_RGB32);
+        quint32 seed = 1;
+        for (int y = 0; y < noise.height(); ++y) {
+            for (int x = 0; x < noise.width(); ++x) {
+                seed = seed * 1664525 + 1013904223;
+                noise.setPixel(x, y, 0xff000000 | (seed & 0x00ffffff));
+            }
+        }
+        const QString encoded = PhoneNotification::iconPngBase64(QIcon(QPixmap::fromImage(noise)));
+        const QByteArray png = QByteArray::fromBase64(encoded.toLatin1());
+        QVERIFY(!png.isEmpty());
+        QVERIFY(png.size() <= 16 * 1024);
+        const QImage decoded = QImage::fromData(png, "PNG");
+        QVERIFY(!decoded.isNull());
+        QVERIFY(decoded.width() <= 256 && decoded.height() <= 256);
+        QVERIFY(decoded.width() < 128); // The noisy 128px PNG exceeds the budget.
+        QVERIFY(PhoneNotification::iconPngBase64(QIcon()).isEmpty());
+    }
+
+    void keyboardAndRetry()
+    {
+        TestDialog dialog({.user = "root", .authUser = "root", .command = QStringLiteral("true")});
+        dialog.show();
+        auto *password = dialog.findChild<KPasswordLineEdit *>();
+        QTRY_VERIFY(password->lineEdit()->hasFocus());
+        auto *accessible = QAccessible::queryAccessibleInterface(password->lineEdit());
+        QVERIFY(accessible);
+        QVERIFY(accessible->state().passwordEdit);
+        QVERIFY(!accessible->text(QAccessible::Name).isEmpty());
+        password->setPassword(QStringLiteral("test-only"));
+        QSignalSpy accepted(&dialog, &QDialog::accepted);
+        QTest::keyClick(password->lineEdit(), Qt::Key_Return);
+        QTRY_COMPARE(dialog.attempts, 1);
+        QCOMPARE(accepted.size(), 0);
+        QVERIFY(dialog.password().isEmpty());
+        QVERIFY(password->lineEdit()->hasFocus());
+        QVERIFY(dialog.findChild<KMessageWidget *>()->isVisible());
+        dialog.authenticated = true;
+        password->setPassword(QStringLiteral("test-only"));
+        QTest::keyClick(password->lineEdit(), Qt::Key_Return);
+        QTRY_COMPARE(accepted.size(), 1);
+        QCOMPARE(dialog.password(), QStringLiteral("test-only"));
+    }
+
+    void fatalErrorAndIgnore()
+    {
+        TestDialog dialog({.user = "root", .authUser = "root", .command = QStringLiteral("true"), .withIgnoreButton = true});
+        dialog.fatal = true;
+        dialog.show();
+        dialog.accept();
+        QTRY_COMPARE(dialog.attempts, 1);
+        auto *buttons = dialog.findChild<QDialogButtonBox *>();
+        QVERIFY(!buttons->button(QDialogButtonBox::Ok)->isEnabled());
+        QVERIFY(buttons->button(QDialogButtonBox::Cancel)->isEnabled());
+        dialog.accept();
+        QCOMPARE(dialog.attempts, 1);
+        buttons->button(QDialogButtonBox::Ignore)->click();
+        QCOMPARE(dialog.result(), int(KDEsuDialog::AsUser));
+        QCOMPARE(dialog.attempts, 1);
+    }
+
+    void hiddenRememberPassword()
+    {
+        TestDialog dialog({.user = "root", .authUser = "root", .command = QStringLiteral("true")});
+        dialog.setKeepPassword(true);
+        QVERIFY(!dialog.keepPassword());
+    }
+
+    void cancellationWinsOverQueuedAuthentication()
+    {
+        TestDialog dialog({.user = "root", .authUser = "root", .command = QStringLiteral("true")});
+        dialog.authenticated = true;
+        dialog.show();
+        dialog.accept();
+        dialog.reject();
+        QCoreApplication::processEvents();
+        QCOMPARE(dialog.attempts, 0);
+        QCOMPARE(dialog.result(), int(QDialog::Rejected));
+    }
+
+    void keyboardDetailsAndNarrowLayout()
+    {
+        TestDialog dialog({.user = "root", .authUser = "root", .command = QStringLiteral("printf '%s' 'literal text'"), .withIgnoreButton = true});
+        dialog.resize(380, 420);
+        dialog.show();
+        auto *password = dialog.findChild<KPasswordLineEdit *>()->lineEdit();
+        auto *scroll = dialog.findChild<QScrollArea *>();
+        QTRY_VERIFY(scroll->viewport()->rect().contains(QRect(password->mapTo(scroll->viewport(), QPoint()), password->size())));
+        auto *toggle = dialog.findChild<QToolButton *>(QStringLiteral("explainCommand"));
+        auto *details = dialog.findChild<QTextBrowser *>();
+        toggle->setFocus();
+        QTest::keyClick(toggle, Qt::Key_Space);
+        QVERIFY(details->isVisible());
+        QTest::keyClick(toggle, Qt::Key_Space);
+        QVERIFY(details->isHidden());
+        auto *buttons = dialog.findChild<QDialogButtonBox *>();
+        for (auto *button : buttons->buttons()) {
+            QVERIFY(dialog.rect().contains(QRect(button->mapTo(&dialog, QPoint()), button->size())));
+        }
+        QTest::keyClick(toggle, Qt::Key_Escape);
+        QCOMPARE(dialog.result(), int(QDialog::Rejected));
+        QCOMPARE(dialog.attempts, 0);
+    }
+};
+
+QTEST_MAIN(DialogTest)
