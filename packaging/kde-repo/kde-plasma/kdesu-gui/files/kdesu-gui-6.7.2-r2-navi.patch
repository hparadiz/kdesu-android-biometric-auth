diff --git a/kdesu/phoneauthclient.cpp b/kdesu/phoneauthclient.cpp
new file mode 100644
index 00000000..3fa39f80
--- /dev/null
+++ b/kdesu/phoneauthclient.cpp
@@ -0,0 +1,383 @@
+/*
+ * SPDX-FileCopyrightText: 2026 KDE contributors
+ * SPDX-License-Identifier: Artistic-2.0
+ */
+
+#include "phoneauthclient.h"
+
+#include <KLocalizedString>
+#include <QDir>
+#include <QFile>
+#include <QFileInfo>
+#include <QJsonDocument>
+#include <QProcess>
+#include <QProcessEnvironment>
+#include <QTimer>
+#include <QUuid>
+
+#include <sys/stat.h>
+#include <unistd.h>
+
+namespace
+{
+const QString protocol = QStringLiteral("navi-auth-exec/v1");
+constexpr qsizetype maximumStartBytes = 64 * 1024;
+constexpr qsizetype maximumReplyBytes = 16 * 1024;
+constexpr int withdrawalGraceMs = 35000; // Up to 15s delivery + 15s signed cancellation, then margin.
+
+QByteArray line(const QJsonObject &object)
+{
+    return QJsonDocument(object).toJson(QJsonDocument::Compact) + '\n';
+}
+
+void releaseHelper(QProcess *process, bool committed)
+{
+    if (!process) {
+        return;
+    }
+    // A running QProcess destructor kills and waits. In particular, the GUI may
+    // not be allowed to signal a helper which normalized its real UID to root.
+    // Leave cleanup asynchronous and unparented: application exit closes the
+    // pipes; the protected helper owns EOF cleanup and its absolute 180s limit.
+    process->setParent(nullptr);
+    process->disconnect();
+    if (process->state() == QProcess::NotRunning) {
+        process->deleteLater();
+        return;
+    }
+    QObject::connect(process, &QProcess::finished, process, &QObject::deleteLater);
+    QObject::connect(process, &QProcess::errorOccurred, process, [process] {
+        if (process->state() == QProcess::NotRunning) {
+            process->deleteLater(); // FailedToStart does not emit finished.
+        }
+    });
+    QObject::connect(process, &QProcess::readyReadStandardOutput, process, [process] {
+        process->readAllStandardOutput();
+    });
+    QObject::connect(process, &QProcess::readyReadStandardError, process, [process] {
+        process->readAllStandardError();
+    });
+    QObject::connect(process, &QProcess::started, process, [process] {
+        process->closeWriteChannel();
+    });
+    process->closeWriteChannel();
+    if (!committed) {
+        QTimer::singleShot(withdrawalGraceMs, process, [process] {
+            if (process->state() != QProcess::NotRunning) {
+                process->terminate(); // Best effort only; never treat a signal attempt as an acknowledgement.
+                QTimer::singleShot(1000, process, [process] {
+                    if (process->state() != QProcess::NotRunning) {
+                        process->kill();
+                    }
+                });
+            }
+        });
+    }
+}
+}
+
+PhoneAuthClient::PhoneAuthClient(QObject *parent)
+    : QObject(parent)
+    , m_startTimeout(new QTimer(this))
+    , m_lifetime(new QTimer(this))
+    , m_shutdownGrace(new QTimer(this))
+    , m_requestId(QUuid::createUuid().toString(QUuid::WithoutBraces))
+{
+    m_startTimeout->setSingleShot(true);
+    m_startTimeout->setInterval(1500);
+    m_lifetime->setSingleShot(true);
+    m_lifetime->setObjectName(QStringLiteral("phoneAuthDeadline"));
+    m_lifetime->setInterval(125000); // Approval/commit freshness is enforced by the helper at 120s.
+    m_shutdownGrace->setSingleShot(true);
+    connect(m_startTimeout, &QTimer::timeout, this, [this] {
+        fail(i18n("The phone authentication helper did not start."));
+    });
+    connect(m_lifetime, &QTimer::timeout, this, [this] {
+        fail(i18n("The phone authentication request timed out."));
+    });
+    connect(m_shutdownGrace, &QTimer::timeout, this, [this] {
+        if (!m_process || m_committed || m_process->state() == QProcess::NotRunning) {
+            return;
+        }
+        if (!m_terminationAttempted) {
+            m_terminationAttempted = true;
+            m_process->terminate();
+            m_shutdownGrace->start(1000);
+        } else {
+            m_process->kill();
+        }
+        // Only an acknowledged cancellation or actual process termination can
+        // release a pending password fallback. Permission to signal may be denied.
+    });
+}
+
+PhoneAuthClient::~PhoneAuthClient()
+{
+    cancel();
+    releaseHelper(m_process, m_committed);
+    m_process = nullptr;
+}
+
+QString PhoneAuthClient::helperPath() const
+{
+    return QStringLiteral("/usr/libexec/navi-auth/authorize");
+}
+
+bool PhoneAuthClient::trustedHelper(const QString &path) const
+{
+    if (!QDir::isAbsolutePath(path)) {
+        return false;
+    }
+    struct stat info;
+    if (lstat(QFile::encodeName(path).constData(), &info) != 0 || !S_ISREG(info.st_mode) || info.st_uid != 0 || !(info.st_mode & S_ISUID)
+        || (info.st_mode & 0022) != 0 || access(QFile::encodeName(path).constData(), X_OK) != 0) {
+        return false;
+    }
+    QString directory = QFileInfo(path).absolutePath();
+    for (;;) {
+        if (lstat(QFile::encodeName(directory).constData(), &info) != 0 || !S_ISDIR(info.st_mode) || info.st_uid != 0 || (info.st_mode & 0022) != 0) {
+            return false;
+        }
+        if (directory == QLatin1String("/")) {
+            return true;
+        }
+        directory = QFileInfo(directory).absolutePath();
+    }
+}
+
+void PhoneAuthClient::start(const QJsonObject &context, const QJsonObject &environment)
+{
+    if (m_state != State::Idle) {
+        return;
+    }
+    if (context.value(QStringLiteral("source")) != QJsonValue(QStringLiteral("kdesu")) || context.value(QStringLiteral("command_hidden")) != QJsonValue(false)
+        || context.value(QStringLiteral("target_user")) != QJsonValue(QStringLiteral("root"))) {
+        fail(i18n("This request requires password authentication."));
+        return;
+    }
+    m_startLine = line({{QStringLiteral("protocol"), protocol},
+                        {QStringLiteral("event"), QStringLiteral("start")},
+                        {QStringLiteral("request_id"), m_requestId},
+                        {QStringLiteral("context"), context},
+                        {QStringLiteral("cwd"), QDir::currentPath()},
+                        {QStringLiteral("environment"), environment}});
+    if (m_startLine.size() > maximumStartBytes || !trustedHelper(helperPath())) {
+        fail(i18n("The phone authentication helper is unavailable or could not be verified."));
+        return;
+    }
+    m_process = new QProcess(this);
+    m_process->setProgram(helperPath());
+    m_process->setArguments({});
+    m_process->setWorkingDirectory(QStringLiteral("/"));
+    QProcessEnvironment helperEnvironment;
+    helperEnvironment.insert(QStringLiteral("PATH"), QStringLiteral("/usr/bin:/bin"));
+    helperEnvironment.insert(QStringLiteral("LANG"), QStringLiteral("C.UTF-8"));
+    m_process->setProcessEnvironment(helperEnvironment);
+    m_process->setProcessChannelMode(QProcess::SeparateChannels);
+    connect(m_process, &QProcess::started, this, [this] {
+        m_startTimeout->stop();
+        if (m_state == State::Cancelling) {
+            m_process->closeWriteChannel();
+            return;
+        }
+        m_state = State::Waiting;
+        m_startSent = true;
+        if (m_process->write(m_startLine) != m_startLine.size()) {
+            fail(i18n("Could not send the phone authentication request."));
+            return;
+        }
+        m_startLine.clear();
+        Q_EMIT waitingForPhone();
+    });
+    connect(m_process, &QProcess::readyReadStandardOutput, this, &PhoneAuthClient::readMessages);
+    connect(m_process, &QProcess::readyReadStandardError, this, [this] {
+        // Diagnostics never enter the protocol or accumulate in an unbounded log.
+        m_process->readAllStandardError();
+    });
+    connect(m_process, &QProcess::finished, this, [this] {
+        readMessages(); // A final executed line may arrive together with process exit.
+        if (m_state != State::Finished) {
+            fail(m_failure.isEmpty() ? i18n("The phone authentication helper exited.") : m_failure);
+        }
+    });
+    connect(m_process, &QProcess::errorOccurred, this, [this] {
+        readMessages();
+        if (m_state != State::Finished) {
+            fail(i18n("The phone authentication helper is unavailable."));
+        }
+    });
+    m_state = State::Starting;
+    m_startTimeout->start();
+    m_lifetime->start();
+    m_process->start(QIODevice::ReadWrite);
+}
+
+QByteArray PhoneAuthClient::message(const QString &event) const
+{
+    return line({{QStringLiteral("protocol"), protocol}, {QStringLiteral("event"), event}, {QStringLiteral("request_id"), m_requestId}});
+}
+
+bool PhoneAuthClient::pending() const
+{
+    return m_state == State::Starting || m_state == State::Waiting || m_state == State::Cancelling;
+}
+
+bool PhoneAuthClient::committed() const
+{
+    return m_committed;
+}
+
+void PhoneAuthClient::commit()
+{
+    if (m_state != State::Waiting || !m_ready) {
+        return;
+    }
+    m_committed = true;
+    m_state = State::Committed;
+    // This is a receipt/launch-ack deadline, not an extension of approval freshness.
+    m_lifetime->start(20000);
+    const QByteArray commitLine = message(QStringLiteral("commit"));
+    if (m_process->write(commitLine) != commitLine.size()) {
+        fail(i18n("Could not confirm the phone-authorized execution."));
+    }
+}
+
+void PhoneAuthClient::withdraw()
+{
+    if (m_withdrawing || !m_process) {
+        return;
+    }
+    m_withdrawing = true;
+    if (m_startSent) {
+        m_process->write(message(QStringLiteral("cancel")));
+    }
+    m_process->closeWriteChannel();
+    m_shutdownGrace->start(withdrawalGraceMs);
+}
+
+void PhoneAuthClient::cancel()
+{
+    if (m_state == State::Finished || m_committed || m_cancelRequested) {
+        return;
+    }
+    m_cancelRequested = true;
+    m_state = State::Cancelling;
+    if (!m_process || m_process->state() == QProcess::NotRunning) {
+        finish();
+        Q_EMIT canceled();
+        return;
+    }
+    withdraw();
+}
+
+void PhoneAuthClient::finish()
+{
+    m_state = State::Finished;
+    m_startTimeout->stop();
+    m_lifetime->stop();
+    m_shutdownGrace->stop();
+    m_startLine.clear();
+    m_input.clear();
+    releaseHelper(m_process, m_committed);
+    m_process = nullptr;
+}
+
+void PhoneAuthClient::fail(const QString &message)
+{
+    if (m_state == State::Finished) {
+        return;
+    }
+    if (!m_committed && m_process && m_process->state() != QProcess::NotRunning) {
+        m_failure = message;
+        m_input.clear();
+        m_state = State::Cancelling;
+        withdraw();
+        return;
+    }
+    finish();
+    if (m_committed) {
+        Q_EMIT uncertain(message);
+    } else if (m_cancelRequested) {
+        Q_EMIT canceled();
+    } else {
+        Q_EMIT unavailable(message);
+    }
+}
+
+void PhoneAuthClient::readMessages()
+{
+    if (m_state == State::Finished || !m_process) {
+        return;
+    }
+    m_input += m_process->read(maximumReplyBytes + 1 - m_input.size());
+    qsizetype newline;
+    while ((newline = m_input.indexOf('\n')) >= 0) {
+        if (newline + 1 > maximumReplyBytes) {
+            fail(i18n("The phone authentication helper sent an invalid response."));
+            return;
+        }
+        const QJsonDocument document = QJsonDocument::fromJson(m_input.left(newline));
+        m_input.remove(0, newline + 1);
+        const QJsonObject reply = document.object();
+        if (!document.isObject() || reply.value(QStringLiteral("protocol")) != QJsonValue(protocol)
+            || reply.value(QStringLiteral("request_id")) != QJsonValue(m_requestId)) {
+            fail(i18n("The phone authentication response did not match this request."));
+            return;
+        }
+        const QString event = reply.value(QStringLiteral("event")).toString();
+        if (event == QLatin1String("ready") && m_state == State::Cancelling) {
+            continue;
+        }
+        if (event == QLatin1String("ready") && m_state == State::Waiting && !m_ready) {
+            m_ready = true;
+            Q_EMIT ready();
+        } else if (event == QLatin1String("canceled") && !m_committed && pending()) {
+            const bool canceledByUser = m_cancelRequested;
+            const QString failure = m_failure;
+            finish();
+            if (!canceledByUser && !failure.isEmpty()) {
+                Q_EMIT unavailable(failure);
+            } else {
+                Q_EMIT canceled();
+            }
+            return;
+        } else if (event == QLatin1String("executed") && m_state == State::Committed && reply.value(QStringLiteral("pid")).isDouble()) {
+            const double pid = reply.value(QStringLiteral("pid")).toDouble();
+            if (pid < 1 || pid > 2147483647 || pid != qint64(pid)) {
+                fail(i18n("The phone authentication helper returned an invalid process ID."));
+                return;
+            }
+            finish();
+            Q_EMIT executed(qint64(pid));
+            return;
+        } else if (event == QLatin1String("error") && reply.value(QStringLiteral("message")).isString()) {
+            const QString message = reply.value(QStringLiteral("message")).toString().left(512);
+            if (m_committed) {
+                fail(message);
+            } else {
+                // A matching precommit error is the helper's terminal rejection.
+                finish();
+                if (m_cancelRequested) {
+                    Q_EMIT canceled();
+                } else {
+                    Q_EMIT unavailable(message);
+                }
+            }
+            return;
+        } else {
+            fail(i18n("The phone authentication helper returned an unexpected response."));
+            return;
+        }
+        if (m_state == State::Finished) {
+            return;
+        }
+    }
+    if (m_input.size() >= maximumReplyBytes) {
+        fail(i18n("The phone authentication helper sent an oversized response."));
+    }
+    if (m_process && m_process->bytesAvailable() > 0) {
+        QMetaObject::invokeMethod(this, &PhoneAuthClient::readMessages, Qt::QueuedConnection);
+    }
+}
+
+#include "moc_phoneauthclient.cpp"
