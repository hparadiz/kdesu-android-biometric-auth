+void KDEsuDialog::updateStyle()
+{
+    const QColor accent = palette().color(QPalette::Highlight);
+    const auto linear = [](qreal component) {
+        return component <= 0.04045 ? component / 12.92 : std::pow((component + 0.055) / 1.055, 2.4);
+    };
+    const qreal luminance = 0.2126 * linear(accent.redF()) + 0.7152 * linear(accent.greenF()) + 0.0722 * linear(accent.blueF());
+    // Whichever of black and white has higher contrast against the theme accent
+    // always exceeds 4.5:1. Do not assume HighlightedText meets that threshold.
+    const QString foreground = luminance > 0.179 ? QStringLiteral("#000000") : QStringLiteral("#ffffff");
+    setStyleSheet(
+        QStringLiteral(
+            "QFrame#accountCard { background: palette(base); border: 1px solid palette(mid); border-radius: 12px; }"
+            "QPlainTextEdit#commandText { background: palette(base); border: 1px solid palette(mid); border-radius: 10px; padding: 10px; }"
+            "QPlainTextEdit#commandText:focus { border: 1px solid palette(highlight); }"
+            "QPushButton#authorizeButton { background: palette(highlight); color: %1; border: 2px solid transparent; border-radius: 6px; padding: 4px 14px; }"
+            "QPushButton#authorizeButton:focus { border-color: %1; }"
+            "QPushButton#authorizeButton:hover { border-color: %1; }"
+            "QPushButton#authorizeButton:pressed { background: palette(button); color: palette(button-text); }"
+            "QPushButton#authorizeButton:disabled { background: palette(button); color: palette(button-text); }")
+            .arg(foreground));
+}
