+class FakeAuthority
+{
+public:
+    QTemporaryDir directory;
+    QFile events;
+    QFile commands;
+    QJsonObject start;
+
+    QString path() const
+    {
+        return directory.filePath(QStringLiteral("authorize"));
+    }
+    bool listen()
+    {
+        if (!directory.isValid() || !QFile::copy(QCoreApplication::applicationDirPath() + QStringLiteral("/kdesu_fake_authority"), path()))
+            return false;
+        events.setFileName(path() + QStringLiteral(".events"));
+        if (!events.open(QIODevice::WriteOnly))
+            return false;
+        events.close();
+        if (!events.open(QIODevice::ReadOnly))
+            return false;
+        commands.setFileName(path() + QStringLiteral(".commands"));
+        return commands.open(QIODevice::WriteOnly | QIODevice::Append);
+    }
+    bool acceptConnection() const
+    {
+        return QFile::exists(path() + QStringLiteral(".started"));
+    }
+    bool hasEvent()
+    {
+        return events.peek(events.size() - events.pos()).contains('\n');
+    }
+    bool sawEof() const
+    {
+        return QFile::exists(path() + QStringLiteral(".eof"));
+    }
+    bool readStart()
+    {
+        if (start.isEmpty() && hasEvent())
+            start = takeEvent();
+        return !start.isEmpty();
+    }
+    QJsonObject takeEvent()
+    {
+        return QJsonDocument::fromJson(events.readLine()).object();
+    }
+    QJsonObject reply(const QString &event) const
+    {
+        return {{QStringLiteral("protocol"), QStringLiteral("navi-auth-exec/v1")},
+                {QStringLiteral("request_id"), start.value(QStringLiteral("request_id"))},
+                {QStringLiteral("event"), event}};
+    }
+    void instruction(const QJsonObject &object)
+    {
+        commands.write(QJsonDocument(object).toJson(QJsonDocument::Compact) + '\n');
+        commands.flush();
+    }
+    void send(QJsonObject object)
+    {
+        instruction({{QStringLiteral("stdout"), QString::fromLatin1((QJsonDocument(object).toJson(QJsonDocument::Compact) + '\n').toBase64())}});
+    }
+    void raw(const QByteArray &bytes, const QString &channel = QStringLiteral("stdout"))
+    {
+        instruction({{channel, QString::fromLatin1(bytes.toBase64())}});
+    }
+    void exit(int code = 0)
+    {
+        instruction({{QStringLiteral("exit"), code}});
+    }
+};
