+// Unprivileged stdio fixture for phoneauthtest. Never installed or used by kdesu.
+#include <QCoreApplication>
+#include <QDir>
+#include <QFile>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QSocketNotifier>
+#include <QTimer>
+
+#include <cerrno>
+#include <cstdio>
+#include <fcntl.h>
+#include <unistd.h>
+
+int main(int argc, char **argv)
+{
+    QCoreApplication app(argc, argv);
+    const QString prefix = QCoreApplication::applicationFilePath();
+    QFile commands(prefix + QStringLiteral(".commands"));
+    QFile events(prefix + QStringLiteral(".events"));
+    if (!commands.open(QIODevice::ReadOnly) || !events.open(QIODevice::WriteOnly | QIODevice::Append)) {
+        return 2;
+    }
+    QFile metadata(prefix + QStringLiteral(".started"));
+    if (!metadata.open(QIODevice::WriteOnly))
+        return 2;
+    metadata.write(QJsonDocument(QJsonObject{{QStringLiteral("argc"), argc},
+                                             {QStringLiteral("cwd"), QDir::currentPath()},
+                                             {QStringLiteral("inherited_secret"), qEnvironmentVariableIsSet("NAVIAUTH_TEST_SECRET")}})
+                       .toJson(QJsonDocument::Compact));
+    metadata.close();
+    fcntl(STDIN_FILENO, F_SETFL, fcntl(STDIN_FILENO, F_GETFL) | O_NONBLOCK);
+    QSocketNotifier input(STDIN_FILENO, QSocketNotifier::Read);
+    QByteArray buffered;
+    QObject::connect(&input, &QSocketNotifier::activated, &app, [&] {
+        char chunk[4096];
+        ssize_t count;
+        while ((count = ::read(STDIN_FILENO, chunk, sizeof(chunk))) > 0) {
+            buffered.append(chunk, count);
+            qsizetype newline;
+            while ((newline = buffered.indexOf('\n')) >= 0) {
+                events.write(buffered.left(newline + 1));
+                events.flush();
+                buffered.remove(0, newline + 1);
+            }
+        }
+        if (count == 0) {
+            input.setEnabled(false);
+            QFile eof(prefix + QStringLiteral(".eof"));
+            if (!eof.open(QIODevice::WriteOnly)) {
+                app.exit(2);
+                return;
+            }
+            eof.close();
+            // Leave time for the test to deliver a late ready/canceled race.
+            QTimer::singleShot(500, &app, &QCoreApplication::quit);
+        }
+    });
+    QTimer output;
+    output.setInterval(10);
+    QObject::connect(&output, &QTimer::timeout, &app, [&] {
+        while (commands.peek(commands.size() - commands.pos()).contains('\n')) {
+            const QJsonObject command = QJsonDocument::fromJson(commands.readLine()).object();
+            for (const auto &channel : {"stdout", "stderr"}) {
+                if (command.contains(QLatin1String(channel))) {
+                    const QByteArray bytes = QByteArray::fromBase64(command.value(QLatin1String(channel)).toString().toLatin1());
+                    FILE *stream = channel[3] == 'o' ? stdout : stderr;
+                    fwrite(bytes.constData(), 1, size_t(bytes.size()), stream);
+                    fflush(stream);
+                }
+            }
+            if (command.contains(QStringLiteral("exit"))) {
+                app.exit(command.value(QStringLiteral("exit")).toInt());
+                return;
+            }
+        }
+    });
+    output.start();
+    QTimer::singleShot(10000, &app, &QCoreApplication::quit);
+    return app.exec();
+}
