+/*
+ * SPDX-FileCopyrightText: 2026 KDE contributors
+ * SPDX-License-Identifier: Artistic-2.0
+ */
+
+#include "programinfo.h"
+
+#include <KDesktopFile>
+#include <QFileInfo>
+#include <QStandardPaths>
+
+ProgramInfo programInfo(const QString &executable)
+{
+    const QString name = QFileInfo(executable).fileName();
+    ProgramInfo info{name, QIcon::fromTheme(name, QIcon::fromTheme(QStringLiteral("application-x-executable")))};
+    if (name.isEmpty()) {
+        return info;
+    }
+    // An arbitrary path with the same basename is not the desktop application.
+    if (executable.contains(QLatin1Char('/'))
+        && (QFileInfo(executable).canonicalFilePath().isEmpty()
+            || QFileInfo(executable).canonicalFilePath() != QFileInfo(QStandardPaths::findExecutable(name)).canonicalFilePath())) {
+        return {executable, QIcon::fromTheme(QStringLiteral("application-x-executable"))};
+    }
+    // The CLI does not necessarily install a desktop entry or an icon.
+    if (name == QLatin1String("codex")) {
+        info.name = QStringLiteral("Codex");
+        info.icon =
+            QIcon::fromTheme(QStringLiteral("codex"), QIcon::fromTheme(QStringLiteral("com.openai.codex"), QIcon(QStringLiteral(":/kdesu/icons/codex.svg"))));
+    }
+    const QStringList desktopNames = {name + QStringLiteral(".desktop"), QStringLiteral("org.kde.") + name + QStringLiteral(".desktop")};
+    for (const QString &desktopName : desktopNames) {
+        const QString path = QStandardPaths::locate(QStandardPaths::ApplicationsLocation, desktopName);
+        if (!path.isEmpty()) {
+            const KDesktopFile desktop(path);
+            info.name = desktop.readName().isEmpty() ? name : desktop.readName();
+            info.icon = QIcon::fromTheme(desktop.readIcon(), info.icon);
+            break;
+        }
+    }
+    return info;
+}
