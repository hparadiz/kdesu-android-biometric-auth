+        QVERIFY(!QUuid(start.value(QStringLiteral("request_id")).toString()).isNull());
+        QCOMPARE(start.value(QStringLiteral("context")).toObject().value(QStringLiteral("command")).toString(), QStringLiteral("printf '%s' 'line\nbreak'"));
+        QVERIFY(!peer->canReadLine());
+        peer->write("{\"approved\":true}\n");
+        peer->flush();
+        QTest::qWait(30);
+        QCOMPARE(accepted.size(), 0);
+        QCOMPARE(dialog.attempts, 0);
+        QVERIFY(dialog.isVisible());
+        dialog.reject();
+        QTRY_VERIFY(peer->canReadLine());
+        const QJsonObject cancel = QJsonDocument::fromJson(peer->readLine()).object();
+        QCOMPARE(cancel.value(QStringLiteral("event")).toString(), QStringLiteral("cancel"));
+        QCOMPARE(cancel.value(QStringLiteral("reason")).toString(), QStringLiteral("dismissed"));
+        QCOMPARE(cancel.value(QStringLiteral("request_id")), start.value(QStringLiteral("request_id")));
+        notification.finish(QStringLiteral("closed"));
+        QTRY_COMPARE(peer->state(), QLocalSocket::UnconnectedState);
+        QVERIFY(!peer->canReadLine());
+    }
+
+    void notificationCancellationDuringConnect()
+    {
+        QTemporaryDir directory;
+        QLocalServer server;
+        server.setSocketOptions(QLocalServer::UserAccessOption);
+        QVERIFY(server.listen(directory.filePath(QStringLiteral("events.sock"))));
+        PhoneNotification notification(server.fullServerName());
+        notification.start({{QStringLiteral("application"), QStringLiteral("Test")}});
+        notification.finish(QStringLiteral("dismissed"));
+        QTRY_VERIFY(server.hasPendingConnections());
+        std::unique_ptr<QLocalSocket> peer(server.nextPendingConnection());
+        QTRY_COMPARE(peer->state(), QLocalSocket::UnconnectedState);
+        // The connect may finish synchronously. Either way, it must end at EOF;
+        // if start was sent, cancel must follow it on that same connection.
+        if (peer->canReadLine()) {
+            const QJsonObject start = QJsonDocument::fromJson(peer->readLine()).object();
+            QVERIFY(peer->canReadLine());
+            const QJsonObject cancel = QJsonDocument::fromJson(peer->readLine()).object();
+            QCOMPARE(cancel.value(QStringLiteral("request_id")), start.value(QStringLiteral("request_id")));
+            QCOMPARE(cancel.value(QStringLiteral("event")).toString(), QStringLiteral("cancel"));
+        }
+        notification.start({});
+        QCoreApplication::processEvents();
+        QVERIFY(!server.hasPendingConnections());
+    }
