+/*
+ * SPDX-FileCopyrightText: 2026 KDE contributors
+ * SPDX-License-Identifier: Artistic-2.0
+ */
+
+#include "../phonenotification.h"
+#include "../sudlg.h"
+
+#include <KColorScheme>
+#include <KLocalizedString>
+#include <QApplication>
+#include <QCommandLineParser>
+#include <QFont>
+#include <QStandardPaths>
+#include <QTimer>
+#include <QToolButton>
+
+class PreviewDialog : public KDEsuDialog
+{
+public:
+    using KDEsuDialog::KDEsuDialog;
+
+protected:
+    bool checkPassword() override
+    {
+        showErrorMessage(i18n("Preview only. No password was checked and no command will run."));
+        return false;
+    }
+};
+
+int main(int argc, char **argv)
+{
+    QApplication app(argc, argv);
+    app.setApplicationName(QStringLiteral("kdesu-dialog-preview"));
+    KLocalizedString::setApplicationDomain(QByteArrayLiteral("kdesu"));
+    QCommandLineParser parser;
+    parser.addHelpOption();
+    parser.addOptions(
+        {{{QStringLiteral("c"), QStringLiteral("command")},
+          QStringLiteral("Command to display; never executed"),
+          QStringLiteral("command"),
+          QStringLiteral("systemsettings kcm_users")},
+         {QStringLiteral("screenshot"), QStringLiteral("Save a PNG and exit"), QStringLiteral("path")},
+         {QStringLiteral("expanded"), QStringLiteral("Expand the command breakdown")},
+         {QStringLiteral("hidden"), QStringLiteral("Hide the command")},
+         {QStringLiteral("notify-phone"), QStringLiteral("Send notification-only lifecycle events to the local phone bridge")},
+         {QStringLiteral("rtl"), QStringLiteral("Use right-to-left layout")},
+         {QStringLiteral("palette"), QStringLiteral("Preview a named KDE color scheme, such as BreezeLight or BreezeDark"), QStringLiteral("name")},
+         {QStringLiteral("font-scale"), QStringLiteral("Scale the application font"), QStringLiteral("factor"), QStringLiteral("1")},
+         {QStringLiteral("width"), QStringLiteral("Preview width"), QStringLiteral("pixels")},
+         {QStringLiteral("height"), QStringLiteral("Preview height"), QStringLiteral("pixels")}});
+    parser.process(app);
+    QFont font = app.font();
+    font.setPointSizeF(font.pointSizeF() * parser.value(QStringLiteral("font-scale")).toDouble());
+    app.setFont(font);
+    if (parser.isSet(QStringLiteral("palette"))) {
+        const QString scheme =
+            QStandardPaths::locate(QStandardPaths::GenericDataLocation, QStringLiteral("color-schemes/%1.colors").arg(parser.value(QStringLiteral("palette"))));
+        if (scheme.isEmpty()) {
+            parser.showHelp(1);
+        }
+        app.setPalette(KColorScheme::createApplicationPalette(KSharedConfig::openConfig(scheme)));
+    }
+    if (parser.isSet(QStringLiteral("rtl"))) {
+        app.setLayoutDirection(Qt::RightToLeft);
+    }
+    PreviewDialog dialog({.user = "root",
+                          .authUser = "root",
+                          .command = parser.value(QStringLiteral("command")),
+                          .showCommand = !parser.isSet(QStringLiteral("hidden")),
+                          .enableKeep = true,
+                          .withIgnoreButton = true});
+    dialog.setWindowTitle(i18n("KDE su — Design preview"));
+    if (parser.isSet(QStringLiteral("notify-phone"))) {
+        auto *notification = new PhoneNotification({}, &dialog);
+        QObject::connect(&dialog, &KDEsuDialog::notificationRequested, notification, [notification](QJsonObject context) {
+            context.insert(QStringLiteral("source"), QStringLiteral("kdesu-preview"));
+            notification->start(context);
+        });
+        QObject::connect(&dialog, &KDEsuDialog::notificationWithdrawn, notification, &PhoneNotification::finish);
+    }
+    if (auto *toggle = dialog.findChild<QToolButton *>(QStringLiteral("explainCommand"))) {
+        toggle->setChecked(parser.isSet(QStringLiteral("expanded")));
+    }
+    dialog.show();
+    if (parser.isSet(QStringLiteral("width")) || parser.isSet(QStringLiteral("height"))) {
+        dialog.resize(parser.isSet(QStringLiteral("width")) ? parser.value(QStringLiteral("width")).toInt() : dialog.width(),
+                      parser.isSet(QStringLiteral("height")) ? parser.value(QStringLiteral("height")).toInt() : dialog.height());
+    }
+    if (parser.isSet(QStringLiteral("screenshot"))) {
+        QTimer::singleShot(300, &dialog, [&] {
+            app.exit(dialog.grab().save(parser.value(QStringLiteral("screenshot"))) ? 0 : 1);
+        });
+    }
+    return app.exec();
+}
