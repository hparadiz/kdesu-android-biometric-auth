+        // the whole focus control clear of the fixed footer as well.
+        const QRect rect(focus->mapTo(m_scroll->viewport(), QPoint()), focus->size());
+        const int viewportHeight = m_scroll->viewport()->height();
+        auto *bar = m_scroll->verticalScrollBar();
+        if (rect.top() < 0) {
+            bar->setValue(bar->value() + rect.top() - 8);
+        } else if (rect.bottom() >= viewportHeight) {
+            bar->setValue(bar->value() + rect.bottom() - viewportHeight + 9);
