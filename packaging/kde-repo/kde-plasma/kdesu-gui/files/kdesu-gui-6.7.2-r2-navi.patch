+        std::unique_ptr<QLocalSocket> peer(server.nextPendingConnection());
+        QTRY_VERIFY(peer->canReadLine());
+        const QJsonObject start = QJsonDocument::fromJson(peer->readLine()).object();
+        QCOMPARE(start.value(QStringLiteral("event")).toString(), QStringLiteral("start"));
+        QCOMPARE(start.value(QStringLiteral("protocol")).toString(), QStringLiteral("navi-auth-desktop/v1"));
