+QPixmap avatar(const KUser &user, int size, qreal dpr, const QPalette &palette)
 {
-    if (!icon.isEmpty()) {
-        setIcon(QIcon::fromTheme(icon));
+    QPixmap result(QSize(size, size) * dpr);
+    result.setDevicePixelRatio(dpr);
+    result.fill(Qt::transparent);
+    QPainter painter(&result);
+    painter.setRenderHint(QPainter::Antialiasing);
+    QPainterPath circle;
+    circle.addEllipse(QRectF(0, 0, size, size));
+    painter.setClipPath(circle);
+    painter.fillRect(QRect(0, 0, size, size), palette.brush(QPalette::AlternateBase));
+    const QPixmap face(user.faceIconPath());
+    if (face.isNull()) {
+        QIcon::fromTheme(QStringLiteral("user-identity")).paint(&painter, QRect(8, 8, size - 16, size - 16));
+    } else {
+        const QPixmap scaled = face.scaled(QSize(size, size) * dpr, Qt::KeepAspectRatioByExpanding, Qt::SmoothTransformation);
+        const QSizeF extent = scaled.size() / dpr;
+        painter.drawPixmap(QRectF((size - extent.width()) / 2, (size - extent.height()) / 2, extent.width(), extent.height()), scaled, scaled.rect());
     }
+    return result;
+}
