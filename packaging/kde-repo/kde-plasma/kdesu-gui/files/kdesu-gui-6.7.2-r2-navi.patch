+/*
+ * SPDX-FileCopyrightText: 2026 KDE contributors
+ * SPDX-License-Identifier: Artistic-2.0
+ */
+
+#pragma once
+
+#include <QJsonObject>
+#include <QObject>
+
+class QIcon;
+class QLocalSocket;
+class QTimer;
+
+// Display metadata only. Neither this transport nor its peer grants authority.
+class PhoneNotification : public QObject
+{
+public:
+    explicit PhoneNotification(const QString &socketPath = {}, QObject *parent = nullptr);
+    ~PhoneNotification() override;
+
+    void start(const QJsonObject &context);
+    void finish(const QString &reason);
+
+    static QString iconPngBase64(const QIcon &icon);
+
+private:
+    QString m_socketPath;
+    QString m_requestId;
+    QByteArray m_startLine;
+    QLocalSocket *m_socket;
+    QTimer *m_connectTimeout;
+    bool m_attempted = false;
+    bool m_started = false;
+    bool m_finished = false;
+};
