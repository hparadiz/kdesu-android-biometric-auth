+namespace
+{
+// An installed `claude` or `claude-desktop` theme icon wins; the Claude desktop app's icon is the fallback.
+QIcon claudeIcon()
+{
+    return QIcon::fromTheme(QStringLiteral("claude"), QIcon::fromTheme(QStringLiteral("claude-desktop"), QIcon(QStringLiteral(":/kdesu/icons/claude.png"))));
+}
+
+// The Claude CLI runs as a versioned binary, ~/.local/share/claude/versions/<version>, with no desktop
+// entry or icon of its own (the `claude` command is a symlink to it).
+bool isClaudeCli(const QString &executable)
+{
+    const QString canonical = QFileInfo(executable).canonicalFilePath();
+    const QString versions = QDir::homePath() + QStringLiteral("/.local/share/claude/versions/");
+    return !canonical.isEmpty() && canonical.startsWith(versions) && !canonical.mid(versions.size()).contains(QLatin1Char('/'))
+        && QFileInfo(canonical).isExecutable();
+}
+}
